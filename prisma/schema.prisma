generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserPlan {
  FREE
  PRO
}

enum Currency {
  USD
  IDR
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum InvestmentCategory {
  CRYPTO
  STOCK
  DEPOSIT
  INDEX
  BOND
  MUTUAL_FUND
  FOREX
  COMMODITY
}

enum InvestmentInstrumentType {
  CRYPTO_ASSET
  COMMON_STOCK
  ETF
  DEPOSIT
  BOND
  OPEN_END_FUND
  INDEX_FUND
  FOREIGN_CURRENCY
  PHYSICAL_COMMODITY
  OTHER
}

enum InvestmentValuationType {
  MARKET_PRICE
  NAV
  FX_RATE
  ACCRUAL
  MANUAL
}

enum InvestmentTransactionType {
  BUY
  SELL
  OPEN
  CLOSE
}

enum InvestmentEventType {
  DIVIDEND
  INTEREST
  COUPON
  DISTRIBUTION
  MATURITY
  PRINCIPAL_RETURN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  plan                         UserPlan           @default(FREE)
  subscriptionStatus           SubscriptionStatus @default(NONE)
  stripeCustomerId             String?            @unique
  stripeSubscriptionId         String?            @unique
  subscriptionCurrentPeriodEnd DateTime?

  accounts Account[]
  sessions Session[]

  incomes          Income[]
  expenses         Expense[]
  investments      Investment[]
  investmentAssets InvestmentAsset[]
  loans            Loan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  currency  Currency @default(USD)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Income {
  id     String @id @default(cuid())
  userId String

  title      String
  category   String
  amount     Decimal  @db.Decimal(12, 2)
  currency   Currency @default(USD)
  receivedAt DateTime
  frequency  String
  notes      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([receivedAt])
}

model Expense {
  id     String @id @default(cuid())
  userId String

  title    String
  category String
  type     String
  amount   Decimal  @db.Decimal(12, 2)
  currency Currency @default(USD)
  spentAt  DateTime
  notes    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([spentAt])
}

model Investment {
  id     String @id @default(cuid())
  userId String

  assetName String
  symbol    String
  category  String

  currency       Currency @default(USD)
  investedAmount Decimal  @db.Decimal(12, 2)
  quantity       Decimal  @db.Decimal(30, 18)
  feeAmount      Decimal  @default(0) @db.Decimal(12, 4)

  investedAt DateTime
  notes      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([investedAt])
}

model InvestmentAsset {
  id     String @id @default(cuid())
  userId String

  name           String
  category       InvestmentCategory
  instrumentType InvestmentInstrumentType
  valuationType  InvestmentValuationType

  // Identity
  symbol          String?
  exchange        String?
  isin            String?
  issuer          String?
  underlyingIndex String?

  // Holding / pricing units
  unit        String?
  pricingUnit String?

  // Currency used by the market quotation.
  // Examples: USD, IDR, JPY, KRW, HKD, EUR.
  marketCurrencyCode String? @db.VarChar(3)

  // Deposit / fixed-income properties
  annualInterestRate Decimal?  @db.Decimal(10, 6)
  couponRate         Decimal?  @db.Decimal(10, 6)
  faceValue          Decimal?  @db.Decimal(18, 4)
  maturityDate       DateTime?

  notes String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions InvestmentTransaction[]
  events       InvestmentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, userId])
  @@index([userId])
  @@index([category])
  @@index([symbol])
}

model InvestmentTransaction {
  id String @id @default(cuid())

  userId  String
  assetId String

  type InvestmentTransactionType

  quantity Decimal? @db.Decimal(30, 18)

  grossAmount Decimal @db.Decimal(18, 4)
  feeAmount   Decimal @default(0) @db.Decimal(18, 4)

  currencyCode String @db.VarChar(3)

  transactedAt DateTime

  notes String?

  asset InvestmentAsset @relation(fields: [assetId, userId], references: [id, userId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([assetId])
  @@index([transactedAt])
}

model InvestmentEvent {
  id String @id @default(cuid())

  userId  String
  assetId String

  type InvestmentEventType

  grossAmount Decimal? @db.Decimal(18, 4)
  feeAmount   Decimal  @default(0) @db.Decimal(18, 4)
  taxAmount   Decimal  @default(0) @db.Decimal(18, 4)

  currencyCode String? @db.VarChar(3)

  occurredAt DateTime

  notes String?

  asset InvestmentAsset @relation(fields: [assetId, userId], references: [id, userId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([assetId])
  @@index([occurredAt])
}

model Loan {
  id     String @id @default(cuid())
  userId String

  title            String
  lenderName       String
  category         String
  currency         Currency  @default(USD)
  principalAmount  Decimal   @db.Decimal(12, 2)
  remainingBalance Decimal   @db.Decimal(12, 2)
  monthlyPayment   Decimal   @db.Decimal(12, 2)
  interestRate     Decimal?  @db.Decimal(5, 2)
  dueDate          DateTime?
  status           String    @default("ACTIVE")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([dueDate])
  @@index([status])
}
